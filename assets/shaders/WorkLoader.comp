#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PC
{
    uint width;
    uint height;
} pc;

layout(std430, binding = 0) readonly buffer PixelWeightsBuffer
{
    uint weights[];
};

layout(std430, binding = 1) buffer WorkQueueBuffer
{
    uint workQueue[];
};

layout(std430, binding = 2) buffer WorkCountBuffer
{
    uint workCount;
};

layout(std430, binding = 3) buffer RayCountBuffer
{
    uint rayCount[];
};

const uint MAX_WORK_ITEMS = 1920u * 1200u;
const uint WEIGHT_SHIFT = 1;
const uint FRAME_SEED = 123456789u;

uint hash_u32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x864ca68bu;
    x ^= x >> 16;
    return x;
}

void main()
{
    uvec2 pix = gl_GlobalInvocationID.xy;
    if (pix.x >= pc.width || pix.y >= pc.height) return;

    uint idx = pix.y * pc.width + pix.x;
    uint weight = weights[idx];
    if (weight == 0u) return;

    uint r = hash_u32(idx ^ FRAME_SEED);
    uint threshold16 = weight >> WEIGHT_SHIFT;
    if (threshold16 > 65535u) threshold16 = 65535u;

    uint r16 = r >> 16;
    if(r16 >= threshold16) return;

    uint slot = atomicAdd(workCount, 1u);
    if (slot < MAX_WORK_ITEMS)
    {
        workQueue[slot] = idx;
    }
}