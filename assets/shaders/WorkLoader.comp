#version 460
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PC
{
    uint width;
    uint height;
} pc;

// Add set=0 explicitly (recommended for Vulkan)
layout(set = 0, binding = 0, std430) readonly buffer PixelWeightsBuffer
{
    uint weights[];
};

layout(set = 0, binding = 1, std430) buffer WorkQueueBuffer
{
    uint workQueue[];
};

layout(set = 0, binding = 2, std430) buffer WorkCountBuffer
{
    uint workCount;
};

// Unused in this shader, ok to remove if not needed
layout(set = 0, binding = 3, std430) buffer RayCountBuffer
{
    uint rayCount[];
};

const uint WEIGHT_SHIFT = 1u;
const uint FRAME_SEED   = 123456789u;

uint hash_u32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x864ca68bu;
    x ^= x >> 16;
    return x;
}

void main()
{
    uvec2 pix = gl_GlobalInvocationID.xy;
    if (pix.x >= pc.width || pix.y >= pc.height) return;

    uint idx = pix.y * pc.width + pix.x;
    uint weight = weights[idx];

    uint r = hash_u32(idx ^ FRAME_SEED);

    uint threshold16 = weight >> WEIGHT_SHIFT;
    threshold16 = min(threshold16, 65535u);

    uint r16 = r >> 16;
    if (r16 >= threshold16) return;

    // Capacity matches the actual frame size (and your workQueue must be sized accordingly!)
    uint maxWorkItems = pc.width * pc.height;

    uint slot = atomicAdd(workCount, 1u);

    // If we overflow, clamp the count so readers don't see nonsense
    if (slot >= maxWorkItems)
    {
        atomicMin(workCount, maxWorkItems);
        return;
    }

    workQueue[slot] = idx;
}
