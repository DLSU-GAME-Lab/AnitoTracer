#version 460
#extension GL_EXT_ray_tracing : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;

layout(binding = 1, set = 0) buffer ResultBuffer 
{
    int objectID;
    int instanceID;
    int primID;
    float hitT;
    float bary0;
    float bary1;
    int hit;
    int padding;
} result;

layout(binding = 2, set = 0) uniform UniformBufferObject 
{
	mat4 ModelView;
	mat4 Projection;
	mat4 ModelViewInverse;
	mat4 ProjectionInverse;
} ubo;

layout(push_constant) uniform PushConstants 
{
    vec4 origin;
    vec4 dir;
} pushConstants;

struct PickerPayload {
    int objectID;
    int instanceID;
    int primID;
    float hitT;
    float bary0;
    float bary1;
    int hit;
    int padding;
};

layout(location = 0) rayPayloadEXT PickerPayload pickerPayload;

void main()
{
    pickerPayload.objectID = -1;
    pickerPayload.instanceID = -1;
    pickerPayload.primID = -1;
    pickerPayload.hitT = 0.0;
    pickerPayload.bary0 = 0.0;
    pickerPayload.bary1 = 0.0;
    pickerPayload.hit = 0;
    pickerPayload.padding = 0;

    vec3 origin = pushConstants.origin.xyz;
    vec3 direction = normalize(pushConstants.dir.xyz);
    
    float tMin = 0.001;
    float tMax = 10000.0;
    
    // Trace ray
    traceRayEXT(
        topLevelAS,           // acceleration structure
        gl_RayFlagsOpaqueEXT, // ray flags
        0xFF,                 // cull mask
        0,                    // sbt record offset
        0,                    // sbt record stride
        0,                    // miss index
        origin,               // ray origin
        tMin,                 // ray min range
        direction,            // ray direction
        tMax,                 // ray max range
        0                     // payload location
    );
    
    // Write results to buffer
    result.objectID = pickerPayload.objectID;
    result.instanceID = pickerPayload.instanceID;
    result.primID = pickerPayload.primID;
    result.hitT = pickerPayload.hitT;
    result.bary0 = pickerPayload.bary0;
    result.bary1 = pickerPayload.bary1;
    result.hit = pickerPayload.hit;
    result.padding = 0;
}
