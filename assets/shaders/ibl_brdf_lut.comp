#version 460

// ── IBL BRDF Integration LUT ─────────────────────────────────────────────────
// Pre-integrates the split-sum BRDF scale (R channel) and bias (G channel)
// over the (NdotV, roughness) domain into a 512×512 RG16F texture.
// X axis = NdotV (0→1), Y axis = roughness (0→1).
// This texture is scene-independent and computed once at startup.
// ─────────────────────────────────────────────────────────────────────────────

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Output: 2D RG16F LUT (R = A scale, G = B bias of split-sum)
layout(binding = 0, rg16f) uniform writeonly image2D outLUT;

const float PI           = 3.14159265359;
const uint  SAMPLE_COUNT = 1024u;

// ── Utility ───────────────────────────────────────────────────────────────────

float RadicalInverse_VdC(uint bits)
{
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N)
{
	return vec2(float(i) / float(N), RadicalInverse_VdC(i));
}

// GGX importance-sampled half-vector in the canonical tangent space (N = Z)
vec3 ImportanceSampleGGX(vec2 Xi, float roughness)
{
	float a        = roughness * roughness;
	float phi      = 2.0 * PI * Xi.x;
	float cosTheta = sqrt((1.0 - Xi.y) / max(1.0 + (a * a - 1.0) * Xi.y, 1e-7));
	float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));

	// Build tangent-space H
	vec3 up = abs(cosTheta) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
	vec3 tx = normalize(cross(up, vec3(cos(phi)*sinTheta, sin(phi)*sinTheta, cosTheta)));
	vec3 ty = cross(vec3(cos(phi)*sinTheta, sin(phi)*sinTheta, cosTheta), tx);

	// Return the half-vector directly in N = (0,0,1) tangent space
	return normalize(vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta));
}

// Smith-Schlick geometry term for the BRDF LUT (uses IBL k = a²/2)
float G_SchlickGGX_IBL(float NdotX, float roughness)
{
	float a = roughness;
	float k = (a * a) / 2.0;
	return NdotX / max(NdotX * (1.0 - k) + k, 1e-7);
}

float G_Smith_IBL(float NdotV, float NdotL, float roughness)
{
	return G_SchlickGGX_IBL(NdotV, roughness) * G_SchlickGGX_IBL(NdotL, roughness);
}

void main()
{
	ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size  = imageSize(outLUT);
	if (coord.x >= size.x || coord.y >= size.y) return;

	// Map pixel to (NdotV, roughness) — offset by 0.5 to sample texel centres
	float NdotV    = (float(coord.x) + 0.5) / float(size.x);
	float roughness = (float(coord.y) + 0.5) / float(size.y);

	// Working in the canonical tangent space: N = (0, 0, 1)
	// V lies in the XZ plane by symmetry.
	vec3 V = vec3(sqrt(max(1.0 - NdotV * NdotV, 0.0)), 0.0, NdotV);
	vec3 N = vec3(0.0, 0.0, 1.0);

	float A = 0.0;   // scale  (F0 coefficient)
	float B = 0.0;   // bias   (1-F0 coefficient)

	for (uint i = 0u; i < SAMPLE_COUNT; ++i)
	{
		vec2 Xi = Hammersley(i, SAMPLE_COUNT);
		vec3 H  = ImportanceSampleGGX(Xi, roughness);

		// Reflect V around H to get L
		vec3 L = normalize(2.0 * dot(V, H) * H - V);

		float NdotL = max(L.z,          0.0);
		float NdotH = max(H.z,          0.0);
		float VdotH = max(dot(V, H),    0.0);

		if (NdotL > 0.0)
		{
			float G     = G_Smith_IBL(max(NdotV, 0.0001), NdotL, roughness);
			// PDF of GGX importance sampling = D*NdotH / (4*VdotH)
			// G_vis absorbs that into the estimator
			float G_vis = (G * VdotH) / max(NdotH * max(NdotV, 0.0001), 1e-7);
			float Fc    = pow(1.0 - VdotH, 5.0);

			A += (1.0 - Fc) * G_vis;
			B += Fc          * G_vis;
		}
	}

	A /= float(SAMPLE_COUNT);
	B /= float(SAMPLE_COUNT);

	imageStore(outLUT, coord, vec4(A, B, 0.0, 1.0));
}
