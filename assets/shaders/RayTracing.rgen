#version 460
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_ARB_shader_clock : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require

#include "Heatmap.glsl"
#include "Random.glsl"
#include "RayPayload.glsl"
#include "RayVertex.glsl"
#include "UniformBufferObject.glsl"

const uint MAX_INSTANCES_PER_PIXEL = 8;
const uint PIXEL_DATA_STRIDE = MAX_INSTANCES_PER_PIXEL + 1;
const uint INVALID_INSTANCE_ID = 0xFFFFFFFF;

layout(push_constant) uniform PushConstants { uint dirtyInstanceCount; };

layout(binding = 0, set = 0) uniform accelerationStructureEXT Scene;
layout(binding = 1, rgba32f) uniform image2D AccumulationImage;  
layout(binding = 2, rgba8) uniform image2D OutputImage;
layout(binding = 3) readonly uniform UniformBufferObjectStruct { UniformBufferObject Camera; };

layout(binding = 12) buffer RayCounter { uint rayCounter; };
layout(binding = 13) buffer RayVertexBuffer { RayVertex Vertices[]; };
layout(binding = 14) buffer RayInfoBuffer { RayInfo info[]; };

layout(std430, binding = 15) buffer PixelInstanceDataBuffer { uint PixelInstanceData[]; };
layout(std430, binding = 16) buffer PixelSampleCountBuffer {uint PixelSampleCount[];};
layout(std430, binding = 17) buffer DirtyInstanceList { uint dirtyInstances[1024]; };

layout(location = 0) rayPayloadEXT RayPayload Ray;


uint getPixelIndex()
{
    return gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x;
}

uint getPixelDataOffset(uint pixelIndex)
{
    return pixelIndex * PIXEL_DATA_STRIDE;
}

bool checkPixelNeedsRetrace(uint pixelIndex)
{
    uint baseOffset = getPixelDataOffset(pixelIndex);
    uint hitCount = PixelInstanceData[baseOffset];
    
    for (uint i = 0; i < hitCount && i < MAX_INSTANCES_PER_PIXEL; ++i)
    {
        uint hitInstance = PixelInstanceData[baseOffset + 1 + i];
        
        // Check if this instance is in the dirty list
        for (uint d = 0; d < dirtyInstanceCount; ++d)
        {
            if (dirtyInstances[d] == hitInstance)
            {
                return true;
            }
        }
    }
    
    return false; // No dirty instances, can reuse
}

void recordInstanceHit(uint pixelIndex, uint instanceID)
{
    uint baseOffset = getPixelDataOffset(pixelIndex);
    uint currentCount = PixelInstanceData[baseOffset];
    
    for (uint i = 0; i < currentCount && i < MAX_INSTANCES_PER_PIXEL; ++i)
    {
        if (PixelInstanceData[baseOffset + 1 + i] == instanceID)
        {
            return;
        }
    }
    
    if (currentCount < MAX_INSTANCES_PER_PIXEL)
    {
        PixelInstanceData[baseOffset + 1 + currentCount] = instanceID;
        PixelInstanceData[baseOffset] = currentCount + 1;
    }
}

void clearPixelInstances(uint pixelIndex)
{
    uint baseOffset = getPixelDataOffset(pixelIndex);
    PixelInstanceData[baseOffset] = 0;
}

void main() 
{
	const uint64_t clock = Camera.ShowHeatmap ? clockARB() : 0;

	const uint pixelIndex = getPixelIndex();
	const ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
	bool needsRetrace = checkPixelNeedsRetrace(pixelIndex);
	uint pixelAccumulatedSamples = PixelSampleCount[pixelIndex];

	if (needsRetrace)
    {
        pixelAccumulatedSamples = 0;  // Reset only this pixel
        clearPixelInstances(pixelIndex);
    }

    if (!needsRetrace && pixelAccumulatedSamples == Camera.TotalNumberOfSamples)
    {
        vec3 accumulatedColor = imageLoad(AccumulationImage, pixelCoord).rgb;
        vec3 pixelColor = accumulatedColor / pixelAccumulatedSamples; 
        pixelColor = sqrt(pixelColor);
        
        if (Camera.ShowHeatmap)
        {
            float convergence = min(float(pixelAccumulatedSamples) / 64.0, 1.0);
            pixelColor = mix(pixelColor, vec3(0, 1, 0), 0.2 * convergence);
        }
        
        imageStore(OutputImage, pixelCoord, vec4(pixelColor, 1));
        return;  // Exit early for this pixel
    }

	// Initialise separate random seeds for the pixel and the rays.
	// - pixel: we want the same random seed for each pixel to get a homogeneous anti-aliasing.
	// - ray: we want a noisy random seed, different for each pixel.
	uint pixelRandomSeed = Camera.RandomSeed;
	Ray.RandomSeed = InitRandomSeed(InitRandomSeed(gl_LaunchIDEXT.x, gl_LaunchIDEXT.y), pixelAccumulatedSamples);

	vec3 pixelColor = vec3(0);

	// Count the rays and set the index
	uint rayIndex = -1;

	uint i = 0;
	uint rayOffset = Camera.NumberOfBounces + 1;


	// Accumulate all the rays for this pixels.
	for (uint s = 0; s < Camera.NumberOfSamples; ++s)
	{
		//if (Camera.NumberOfSamples != Camera.TotalNumberOfSamples) break;
		const vec2 pixel = vec2(gl_LaunchIDEXT.x + RandomFloat(pixelRandomSeed), gl_LaunchIDEXT.y + RandomFloat(pixelRandomSeed));
		const vec2 uv = (pixel / gl_LaunchSizeEXT.xy) * 2.0 - 1.0;

		vec2 offset = Camera.Aperture/2 * RandomInUnitDisk(Ray.RandomSeed);
		vec4 origin = Camera.ModelViewInverse * vec4(offset, 0, 1);
		vec4 target = Camera.ProjectionInverse * (vec4(uv.x, uv.y, 1, 1));
		vec4 direction = Camera.ModelViewInverse * vec4(normalize(target.xyz * Camera.FocusDistance - vec3(offset, 0)), 0);
		vec3 rayColor = vec3(1);

		// Ray scatters are handled in this loop. There are no recursive traceRayEXT() calls in other shaders.
		for (uint b = 0; b <= Camera.NumberOfBounces; ++b)
		{
			const float tMin = 0.001;
			const float tMax = 10000.0;

			// If we've exceeded the ray bounce limit without hitting a light source, no light is gathered.
			// Light emitting materials never scatter in this implementation, allowing us to make this logical shortcut.
			if (b == Camera.NumberOfBounces) 
			{
				rayColor = vec3(0, 0, 0);
				break;
			}

			traceRayEXT(
				Scene, gl_RayFlagsNoneEXT, 0xff, 
				0 /*sbtRecordOffset*/, 0 /*sbtRecordStride*/, 0 /*missIndex*/, 
				origin.xyz, tMin, direction.xyz, tMax, 0 /*payload*/);

			const vec3 hitColor = Ray.ColorAndDistance.rgb;
			const float t = Ray.ColorAndDistance.w;
			const bool isScattered = Ray.ScatterDirection.w > 0;

			const uint hitInstanceID = Ray.InstanceID;  // Now populated from hit shader

			if (t >= 0  && hitInstanceID != INVALID_INSTANCE_ID)
			{
				recordInstanceHit(pixelIndex, hitInstanceID);
			}


			rayColor *= hitColor;

			// Trace missed, or end of trace.
			if (t < 0 || !isScattered)
			{				
				break;
			}

			// Only check the first sample for each pixel
			// If first bounce and did not miss, increment ray counter and store ray info
			if (rayIndex == -1 && s == 0 && b == 0)
			{
				// Atomic Increment, implemented with busy-waiting
				// TODO: isolate this into a function for reusability.
				uint oldCounter, assumedCounter;
				do
				{
					assumedCounter = rayCounter;

					if (assumedCounter >= Camera.MaxRays)
						break;

					oldCounter = atomicCompSwap(rayCounter, assumedCounter, assumedCounter + 1);

					if (oldCounter == assumedCounter)
					{
				        rayIndex = assumedCounter;
				    }
				} while (oldCounter != assumedCounter);

				if (rayIndex != -1) {
					RayVertex vertex;
					vertex.Position = origin.xyz;
					vertex.Color = vec4(1.0);

					Vertices[rayIndex * rayOffset] = vertex;
					Vertices[rayIndex * rayOffset] = vertex;
					i++;

					info[rayIndex].offset = rayOffset;
					info[rayIndex].count  = i;
				}
			}

			// Trace hit.
			origin = origin + t * direction;
			direction = vec4(Ray.ScatterDirection.xyz, 0);

			if (rayIndex != -1 && s == 0)
			{
				RayVertex vertex;
				vertex.Position = origin.xyz;
				vertex.Color = vec4(rayColor, 1.0);
				Vertices[rayIndex * rayOffset + i] = vertex;
				i++;

				info[rayIndex].offset = rayOffset;
				info[rayIndex].count  = i;
			}
		}

		pixelColor += rayColor;
	}

	const vec3 previousAccumulation = pixelAccumulatedSamples > 0 
    ? imageLoad(AccumulationImage, pixelCoord).rgb 
    : vec3(0);

	vec3 accumulatedColor = previousAccumulation + pixelColor;
	pixelAccumulatedSamples += Camera.NumberOfSamples;
    
	PixelSampleCount[pixelIndex] = pixelAccumulatedSamples;
	pixelColor = accumulatedColor / pixelAccumulatedSamples;
	pixelColor = sqrt(pixelColor);

	if (Camera.ShowHeatmap)
	{
		const uint64_t deltaTime = clockARB() - clock;
		const float heatmapScale = 1000000.0f * Camera.HeatmapScale * Camera.HeatmapScale;
		const float deltaTimeScaled = clamp(float(deltaTime) / heatmapScale, 0.0f, 1.0f);

		pixelColor = heatmap(deltaTimeScaled);
	}

	imageStore(AccumulationImage, ivec2(gl_LaunchIDEXT.xy), vec4(accumulatedColor, 0));
    imageStore(OutputImage, ivec2(gl_LaunchIDEXT.xy), vec4(pixelColor, 0));
}
