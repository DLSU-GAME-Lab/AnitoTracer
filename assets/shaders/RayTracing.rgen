#version 460
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_ARB_shader_clock : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require

#include "Heatmap.glsl"
#include "Random.glsl"
#include "RayPayload.glsl"
#include "RayVertex.glsl"
#include "UniformBufferObject.glsl"

layout(binding = 0, set = 0) uniform accelerationStructureEXT Scene;
layout(binding = 1, rgba32f) uniform image2D AccumulationImage;
layout(binding = 2, rgba8)   uniform image2D OutputImage;
layout(binding = 3) readonly uniform UniformBufferObjectStruct { UniformBufferObject Camera; };

layout(binding = 12) buffer RayCounter { uint rayCounter; };          // optional/global
layout(binding = 13) buffer RayVertexBuffer { RayVertex Vertices[]; }; // unused here
layout(binding = 14) buffer RayInfoBuffer   { RayInfo info[]; };       // unused here

layout(binding = 15) buffer RayCountBuffer { uint rayCount[]; };       // per-pixel counts
layout(binding = 16) buffer WorkQueueBuffer { uvec2 workQueue[]; };
layout(binding = 17) buffer WorkQueueCounterBuffer { uint workQueueCount; };

layout(location = 0) rayPayloadEXT RayPayload Ray;

void main()
{
    const uint workItem = gl_LaunchIDEXT.x;

    if (workItem >= workQueueCount)
        return;

    const uvec2 p = workQueue[workItem];
    const uint x = p.x;
    const uint y = p.y;

    const uint width  = Camera.RenderWidth;
    const uint height = Camera.RenderHeight;

    // Safety in case queue contains stale coords
    if (x >= width || y >= height)
        return;

    const uint pixelIndex = x + y * width;

    // Heatmap timing (only valid if enabled)
    const uint64_t clock0 = Camera.ShowHeatmap ? clockARB() : 0;

    // RNG
    uint pixelRandomSeed = Camera.RandomSeed;
    Ray.RandomSeed = InitRandomSeed(InitRandomSeed(x, y), Camera.TotalNumberOfSamples);

    vec3 pixelColor = vec3(0.0);

    // Count how many traceRayEXT calls we do for this pixel in this dispatch
    uint localTraceCount = 0;

    // NOTE:
    // Camera.NumberOfSamples = samples per dispatch
    // Camera.TotalNumberOfSamples = running total after this dispatch (your app logic)
    for (uint s = 0; s < Camera.NumberOfSamples; ++s)
    {
        const vec2 pixel = vec2(float(x) + RandomFloat(pixelRandomSeed),
                                float(y) + RandomFloat(pixelRandomSeed));

        const vec2 renderSize = vec2(float(width), float(height));
        const vec2 uv = (pixel / renderSize) * 2.0 - 1.0;

        vec2 lensOffset = Camera.Aperture * 0.5 * RandomInUnitDisk(Ray.RandomSeed);

        vec4 origin = Camera.ModelViewInverse * vec4(lensOffset, 0.0, 1.0);
        vec4 target = Camera.ProjectionInverse * vec4(uv.x, uv.y, 1.0, 1.0);

        vec3 dirLocal = normalize(target.xyz * Camera.FocusDistance - vec3(lensOffset, 0.0));
        vec4 direction = Camera.ModelViewInverse * vec4(dirLocal, 0.0);

        vec3 rayColor = vec3(1.0);

        for (uint b = 0; b <= Camera.NumberOfBounces; ++b)
        {
            if (b == Camera.NumberOfBounces)
            {
                rayColor = vec3(0.0);
                break;
            }

            const float tMin = 0.001;
            const float tMax = 10000.0;

            localTraceCount++;

            traceRayEXT(
                Scene,
                gl_RayFlagsNoneEXT,
                0xff,
                0, 0, 0,
                origin.xyz, tMin,
                direction.xyz, tMax,
                0
            );

            const vec3  hitColor     = Ray.ColorAndDistance.rgb;
            const float t            = Ray.ColorAndDistance.w;
            const bool  isScattered  = (Ray.ScatterDirection.w > 0.0);

            rayColor *= hitColor;

            if (t < 0.0 || !isScattered)
                break;

            origin    = origin + t * direction;
            direction = vec4(Ray.ScatterDirection.xyz, 0.0);
        }

        pixelColor += rayColor;
    }

    pixelColor /= float(Camera.NumberOfSamples);

    // Store ray stats per pixel (this dispatch only)
    rayCount[pixelIndex] = localTraceCount;

    // Optional: global total counter (atomic)
    // atomicAdd(rayCounter, localTraceCount);

    // Progressive accumulation
    // If TotalNumberOfSamples includes *this* dispatch, then previous total is:
    const uint prevTotal = (Camera.TotalNumberOfSamples >= Camera.NumberOfSamples)
                         ? (Camera.TotalNumberOfSamples - Camera.NumberOfSamples)
                         : 0;

    vec3 accumulated = vec3(0.0);
    if (prevTotal > 0)
        accumulated = imageLoad(AccumulationImage, ivec2(int(x), int(y))).rgb;

    accumulated += pixelColor;

    vec3 finalColor = accumulated / float(max(Camera.TotalNumberOfSamples, 1u));

    // Gamma correction
    finalColor = sqrt(finalColor);

    if (Camera.ShowHeatmap)
    {
        const uint64_t dt = clockARB() - clock0;
        const float heatmapScale = 1000000.0 * Camera.HeatmapScale * Camera.HeatmapScale;
        const float tScaled = clamp(float(dt) / heatmapScale, 0.0, 1.0);
        finalColor = heatmap(tScaled);
    }

    imageStore(AccumulationImage, ivec2(int(p.x), int(p.y)), vec4(accumulated, 0.0));
    imageStore(OutputImage,       ivec2(int(p.x), int(p.y)), vec4(finalColor,  0.0));
}
