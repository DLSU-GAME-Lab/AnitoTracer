#version 460
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_ARB_shader_clock : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require

#include "Heatmap.glsl"
#include "Random.glsl"
#include "RayPayload.glsl"
#include "RayVertex.glsl"
#include "UniformBufferObject.glsl"

layout(binding = 0, set = 0) uniform accelerationStructureEXT Scene;
layout(binding = 1, rgba32f) uniform image2D AccumulationImage;
layout(binding = 2, rgba8) uniform image2D OutputImage;
layout(binding = 3) readonly uniform UniformBufferObjectStruct { UniformBufferObject Camera; };

layout(binding = 12) buffer RayCounter { uint rayCounter; };
layout(binding = 13) buffer RayVertexBuffer { RayVertex Vertices[]; };
layout(binding = 14) buffer RayInfoBuffer { RayInfo info[]; };


struct PixelWorkItem {
    uint x;
    uint y;
};


layout(binding = 15) buffer WorkQueueBuffer { PixelWorkItem workQueue[]; };
layout(binding = 16) buffer WorkQueueCountBuffer { uint workCount; };


layout(location = 0) rayPayloadEXT RayPayload Ray;

uint hash_u32(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x864ca68bu;
    x ^= x >> 16;
    return x;
}

void main()
{
    uint workIndex = gl_LaunchIDEXT.x;
    if (workIndex >= workCount) return;

    PixelWorkItem item = workQueue[workIndex];
    uvec2 pix = uvec2(item.x, item.y);

    const uint64_t clock = Camera.ShowHeatmap ? clockARB() : 0;

    uint pixelId = pix.x + pix.y * Camera.ImageWidth;
    uint pixelRandomSeed = Camera.RandomSeed ^ hash_u32(pixelId);
    uint workSalt = hash_u32(workIndex ^ Camera.TotalNumberOfSamples);

    Ray.RandomSeed = InitRandomSeed(hash_u32(pixelId ^ workSalt), Camera.TotalNumberOfSamples);

    vec3 pixelColor = vec3(0);

    uint rayIndex = uint(-1);
    uint i = 0;
    uint rayOffset = Camera.NumberOfBounces + 1;

    for (uint s = 0; s < Camera.NumberOfSamples; ++s)
    {
        vec2 pixel = vec2(pix.x + RandomFloat(pixelRandomSeed),
                          pix.y + RandomFloat(pixelRandomSeed));

        vec2 screenSize = vec2(Camera.ImageWidth, Camera.ImageHeight);
        vec2 uv = (pixel / screenSize) * 2.0 - 1.0;

        vec2 offset = Camera.Aperture / 2 * RandomInUnitDisk(Ray.RandomSeed);
        vec4 origin = Camera.ModelViewInverse * vec4(offset, 0, 1);
        vec4 target = Camera.ProjectionInverse * vec4(uv.x, uv.y, 1, 1);
        vec4 direction = Camera.ModelViewInverse * vec4(normalize(target.xyz * Camera.FocusDistance - vec3(offset, 0)), 0);

        vec3 rayColor = vec3(1);

        for (uint b = 0; b <= Camera.NumberOfBounces; ++b)
        {
            if (b == Camera.NumberOfBounces) { rayColor = vec3(0); break; }

            traceRayEXT(Scene, gl_RayFlagsNoneEXT, 0xff,
                        0, 0, 0,
                        origin.xyz, 0.001, direction.xyz, 10000.0, 0);

            vec3 hitColor = Ray.ColorAndDistance.rgb;
            float t = Ray.ColorAndDistance.w;
            bool isScattered = (Ray.ScatterDirection.w > 0);

            rayColor *= hitColor;

            if (t < 0 || !isScattered) break;

            origin = origin + t * direction;
            direction = vec4(Ray.ScatterDirection.xyz, 0);
        }

        pixelColor += rayColor;
    }

    bool accumulate = Camera.NumberOfSamples != Camera.TotalNumberOfSamples;
    vec3 accumulatedColor = (accumulate ? imageLoad(AccumulationImage, ivec2(pix)) : vec4(0)).rgb + pixelColor;

    pixelColor = accumulatedColor / Camera.TotalNumberOfSamples;
    pixelColor = sqrt(pixelColor);

    if (Camera.ShowHeatmap)
    {
        uint64_t dt = clockARB() - clock;
        float heatmapScale = 1000000.0f * Camera.HeatmapScale * Camera.HeatmapScale;
        float dtScaled = clamp(float(dt) / heatmapScale, 0.0f, 1.0f);
        pixelColor = heatmap(dtScaled);
    }

    imageStore(AccumulationImage, ivec2(pix), vec4(accumulatedColor, 0));
    imageStore(OutputImage, ivec2(pix), vec4(pixelColor, 0));
}
